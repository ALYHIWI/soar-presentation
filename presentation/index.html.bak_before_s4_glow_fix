}
[dir="rtl"] #stealthDock:not(.open) #dockToggle svg {
  transform: rotate(180deg);
}
[dir="rtl"] #stealthDock.open #dockToggle svg {
  transform: rotate(0deg);
}

.tbtn {
  padding: 6px 12px;
