}
[dir="rtl"] #dockToggle {
  border-left: 1px solid rgba(255, 255, 255, 0.1);
  border-right: none;
  border-radius: 8px 0 0 8px;
}
#dockToggle:hover {
  opacity: 0.95;
  color: var(--s);
