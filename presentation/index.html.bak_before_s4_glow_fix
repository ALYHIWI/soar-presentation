.fs .fl { font-size: 0.74rem; font-weight: 700; color: var(--t1); }
.fs .sub { font-size: 0.65rem; color: var(--t3); }

@keyframes cyberPulse {
  0%, 100% {
    color: var(--p);
    transform: scale(1);
    filter: drop-shadow(0 0 2px var(--p));
  }
  50% {
    color: var(--s);
    transform: scale(1.3);
    filter: drop-shadow(0 0 10px var(--s));
  }
}

.farr {
  color: var(--p);
